{
  "name": "router-bit-label-maker",
  "version": "1.0.0",
  "description": "Standard 12 mm labels for router bits, with pictograms, QR codes and direct printing to Brother P-touch Cube printers from the browser.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs --no-watch",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "node --test --test-concurrency=1 tests/node/",
    "test:browser": "playwright test",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/roboto-condensed": "5.3.0",
    "jszip": "3.10.1",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "jsqr": "1.4.0"
  }
}
